PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.m8z43qb.mongodb.net/campusmatch_db?retryWrites=true&w=majority
